# Copy to .env and fill in. Never commit .env.
ELSEVIER_API_KEY=
# Optional: only if Elsevier issued you an institutional token
ELSEVIER_INSTTOKEN=
SCOPUS_API_BASE_URL=https://api.elsevier.com

# Diagnostic target (first faculty member from the dataset)
DIAG_SCOPUS_AUTHOR_ID=57201310675

# Optional: SerpApi key (serpapi.com) for Google Scholar author data. Leave empty to use manual entry.
SERPAPI_API_KEY=

# HOD login used by the seed script (min 10 chars). The database stores only a hash.
HOD_EMAIL=hod@kletech.ac.in
HOD_PASSWORD=

# Optional: Clarivate Web of Science Starter API key (developer.clarivate.com). Leave empty to use file import.
CLARIVATE_API_KEY=
